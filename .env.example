# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Set in Vercel → Project → Settings → Environment Variables.
# Analytics only loads when this is present.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (the content value of the
# <meta name="google-site-verification" ...> tag). Adds the verification
# meta tag to every page. Only needed if verifying via the HTML tag method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
